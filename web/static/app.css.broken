/* ---------------- Base / Reset ---------------- */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  /* Base */
  --bg: #0F172A;
  --bg-raise: #1E293B;
  --bg-raise-2: #334155;
  --text: #F8FAFC;
  --text-faint: #94A3B8;
  --line: #334155;
  --line-soft: #1E293B;

  /* Accent */
  --accent-cool: #38BDF8;
  --accent-warm: #F97316;

  /* Radius */
  --radius-sm: 6px;
  --radius-md: 8px;

  /* Shadow */
  --shadow-sm: 0 1px 2px rgba(0,0,0,.2);
  --shadow-md: 0 2px 8px rgba(0,0,0,.3);
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

a {
  color: var(--accent-cool);
  text-decoration: none;
}
a:hover {
  text-decoration: underline;
}

img {
  max-width: 100%;
  display: block;
}

/* ---------------- Layout ---------------- */

.container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
}

.row {
  display: flex;
  gap: 24px;
  margin-top: 24px;
}

.col-left {
  flex: 1;
  min-width: 0;
}

.col-preview {
  width: 320px;
  flex: none;
}

@media (max-width: 960px) {
  .row { flex-direction: column; }
  .col-preview { width: 100%; }
}

/* ---------------- Header ---------------- */

.header {
  border-bottom: 1px solid var(--line);
  padding: 16px 0;
  background: var(--bg-raise);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo:hover {
  text-decoration: none;
  color: var(--accent-cool);
}

.nav {
  display: flex;
  gap: 16px;
  align-items: center;
}

.nav a {
  font-size: 13px;
  color: var(--text-faint);
  transition: color .2s;
}

.nav a:hover {
  color: var(--text);
  text-decoration: none;
}

/* ---------------- Main ---------------- */

.main {
  padding: 32px 0;
}

/* ---------------- Card ---------------- */

.card {
  background: var(--bg-raise);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 20px;
  margin-bottom: 20px;
}

.card-title {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 16px;
  color: var(--text);
}

.sticky {
  position: sticky;
  top: 24px;
}

/* ---------------- Form ---------------- */

.form-group {
  margin-bottom: 16px;
}

.form-group:last-child {
  margin-bottom: 0;
}

label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 6px;
  color: var(--text);
}

.input,
.select,
.textarea {
  width: 100%;
  padding: 10px 12px;
  font-size: 14px;
  font-family: inherit;
  color: var(--text);
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  transition: border-color .2s;
}

.input:focus,
.select:focus,
.textarea:focus {
  outline: none;
  border-color: var(--accent-cool);
}

.input::placeholder,
.textarea::placeholder {
  color: var(--text-faint);
}

.textarea {
  resize: vertical;
  min-height: 80px;
}

.input-file {
  display: block;
  width: 100%;
  padding: 10px;
  font-size: 13px;
  color: var(--text-faint);
  background: var(--bg);
  border: 1px dashed var(--line);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: border-color .2s;
}

.input-file:hover {
  border-color: var(--accent-cool);
}

/* ---------------- Button ---------------- */

.btn {
  display: inline-block;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 600;
  font-family: inherit;
  color: var(--text);
  background: var(--bg-raise-2);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: background .2s, border-color .2s;
  text-align: center;
}

.btn:hover {
  background: var(--bg-raise);
  border-color: var(--accent-cool);
}

.btn:active {
  transform: translateY(1px);
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-primary {
  background: var(--accent-warm);
  border-color: var(--accent-warm);
  color: #fff;
}

.btn-primary:hover {
  background: #EA580C;
  border-color: #EA580C;
}

.btn-secondary {
  background: var(--accent-cool);
  border-color: var(--accent-cool);
  color: #0F172A;
}

.btn-secondary:hover {
  background: #0EA5E9;
  border-color: #0EA5E9;
}

.btn-sm {
  padding: 6px 12px;
  font-size: 12.5px;
}

.btn-block {
  width: 100%;
  display: block;
}

.btn-group {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

/* ---------------- Alert ---------------- */

.alert {
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  margin-bottom: 16px;
  font-size: 13px;
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.alert-info {
  background: rgba(56, 189, 248, 0.1);
  border: 1px solid rgba(56, 189, 248, 0.3);
  color: #7DD3FC;
}

.alert-warning {
  background: rgba(249, 115, 22, 0.1);
  border: 1px solid rgba(249, 115, 22, 0.3);
  color: #FB923C;
}

.alert-success {
  background: rgba(74, 222, 128, 0.1);
  border: 1px solid rgba(74, 222, 128, 0.3);
  color: #86EFAC;
}

.alert-error {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
  color: #FCA5A5;
}

/* ---------------- Tab ---------------- */

.tabs {
  display: flex;
  gap: 4px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 16px;
}

.tab {
  padding: 10px 16px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-faint);
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  transition: color .2s, border-color .2s;
}

.tab:hover {
  color: var(--text);
}

.tab.active {
  color: var(--accent-cool);
  border-bottom-color: var(--accent-cool);
}

.tab-content {
  display: none;
}

.tab-content.active {
  display: block;
}

/* ---------------- Badge ---------------- */

.badge {
  display: inline-block;
  padding: 2px 8px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-radius: 4px;
  background: var(--bg-raise-2);
  color: var(--text);
}

.badge-primary {
  background: var(--accent-warm);
  color: #fff;
}

.badge-secondary {
  background: var(--accent-cool);
  color: #0F172A;
}

.badge-faint {
  background: var(--line);
  color: var(--text-faint);
}

/* ---------------- Grid ---------------- */

.grid {
  display: grid;
  gap: 16px;
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

@media (max-width: 640px) {
  .grid-2,
  .grid-3 {
    grid-template-columns: 1fr;
  }
}

/* ---------------- Checkbox / Radio ---------------- */

.checkbox,
.radio {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.checkbox input,
.radio input {
  width: 16px;
  height: 16px;
  cursor: pointer;
}

.checkbox label,
.radio label {
  margin: 0;
  cursor: pointer;
  font-weight: 400;
}

/* ---------------- Loading ---------------- */

.spinner {
  display: inline-block;
  width: 16px;
  height: 16px;
  border: 2px solid var(--line);
  border-top-color: var(--accent-cool);
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------------- Tooltip ---------------- */

[data-tooltip] {
  position: relative;
  cursor: help;
}

[data-tooltip]:hover::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  padding: 6px 10px;
  font-size: 12px;
  white-space: nowrap;
  background: var(--bg-raise-2);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  color: var(--text);
  z-index: 10;
  margin-bottom: 4px;
  pointer-events: none;
}

/* ---------------- Stage / Preview ---------------- */

.stage-wrap {
  display: flex;
  justify-content: center;
  background: var(--bg);
  border-radius: var(--radius-md);
  padding: 12px;
}

.stage {
  position: relative;
  width: 100%;
  max-width: 270px;
  aspect-ratio: 9 / 16;
  background: #000;
  border-radius: var(--radius-sm);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 10px;
}

.stage img,
.stage canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.sprite {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: 2px;
  align-items: center;
  pointer-events: none;
  z-index: 5;
}

.sprite-img {
  width: 100%;
  height: auto;
  display: block;
}

.sprite-label {
  font-size: 10px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 999px;
  background: rgba(0,0,0,.55);
  color: #fff;
  white-space: nowrap;
}
.sprite.pos-left   { align-self: flex-end; }
.sprite.pos-right  { align-self: flex-start; }
.sprite.pos-center { align-self: center; }

.stage-title {
  position: absolute;
  top: 14px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: .04em;
  color: #fff;
  text-shadow: 0 2px 6px rgba(0,0,0,.9);
  padding: 0 6%;
}
.stage-title:empty { display: none; }

.stage-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-faint);
  font-size: 12.5px;
  text-align: center;
  padding: 20px;
}

.stage-legend {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}

/* ---------------- Key/value ---------------- */

.kv { margin: 0; display: flex; flex-direction: column; gap: 7px; }
.kv > div { display: flex; gap: 10px; align-items: baseline; }
.kv dt { font-size: 12.5px; color: var(--text-faint); min-width: 86px; flex: none; }
.kv dd { margin: 0; font-size: 13px; word-break: break-word; }

/* ---------------- Progress / log ---------------- */

.progress-wrap { margin-top: 14px; }
.progress {
  height: 8px;
  background: var(--bg-raise-2);
  border-radius: 999px;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  width: 0%;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--accent-cool), var(--accent-warm));
  transition: width .3s;
}

.log {
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 12px;
  font-family: 'Courier New', monospace;
  font-size: 12px;
  color: var(--text-faint);
  max-height: 200px;
  overflow-y: auto;
  white-space: pre-wrap;
  word-break: break-word;
  margin-top: 12px;
}

/* ---------------- File / Asset list ---------------- */

.file-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.file-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  transition: border-color .2s;
}

.file-item:hover {
  border-color: var(--accent-cool);
}

.file-thumb {
  width: 48px;
  height: 48px;
  flex: none;
  border-radius: 4px;
  object-fit: cover;
  background: var(--bg-raise-2);
}

.file-info {
  flex: 1;
  min-width: 0;
}

.file-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.file-meta {
  font-size: 11.5px;
  color: var(--text-faint);
  margin-top: 2px;
}

.file-actions {
  display: flex;
  gap: 6px;
}

/* ---------------- Joint editor ---------------- */

.joint-editor {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 16px;
}

.joint-row {
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 10px 12px;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
}

.joint-label {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text);
  min-width: 100px;
  flex: none;
}

.joint-input {
  flex: 1;
  padding: 6px 10px;
  font-size: 13px;
  font-family: inherit;
  color: var(--text);
  background: var(--bg-raise);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  transition: border-color .2s;
}

.joint-input:focus {
  outline: none;
  border-color: var(--accent-cool);
}

.joint-input::placeholder {
  color: var(--text-faint);
}

.joint-unit {
  font-size: 12px;
  color: var(--text-faint);
  flex: none;
}

/* ---------------- Rig / Animation ---------------- */

.rig-controls {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}

.rig-status {
  flex: 1;
  font-size: 12.5px;
  color: var(--text-faint);
  text-align: right;
  margin-left: auto;
}

.rig-status.loading {
  color: var(--accent-cool);
  font-weight: 600;
}

.rig-status.ready {
  color: #4ADE80;
}

.joint-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.joint-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 600;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--text);
  cursor: pointer;
  transition: border-color .2s, background .2s;
  user-select: none;
}

.joint-chip:hover {
  background: var(--bg-raise);
  border-color: var(--accent-cool);
}

.joint-chip.selected {
  background: var(--accent-cool);
  border-color: var(--accent-cool);
  color: #0F172A;
}

.joint-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.6;
}

.joint-chip.selected .joint-dot {
  opacity: 1;
}

/* ---------------- Canvas controls ---------------- */

.canvas-controls {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.canvas-btn {
  padding: 8px 12px;
  font-size: 12.5px;
  font-weight: 600;
  font-family: inherit;
  color: var(--text);
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: background .2s, border-color .2s;
  user-select: none;
}

.canvas-btn:hover {
  background: var(--bg-raise);
  border-color: var(--accent-cool);
}

.canvas-btn:active {
  transform: translateY(1px);
}

.canvas-btn.active {
  background: var(--accent-cool);
  border-color: var(--accent-cool);
  color: #0F172A;
}

/* ---------------- Sprite / Layering ---------------- */

.sprite-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sprite-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  transition: border-color .2s;
}

.sprite-card:hover {
  border-color: var(--accent-cool);
}

.sprite-card.dragging {
  opacity: 0.5;
}

.sprite-handle {
  cursor: grab;
  color: var(--text-faint);
  font-size: 16px;
  user-select: none;
}

.sprite-handle:active {
  cursor: grabbing;
}

.sprite-preview {
  width: 48px;
  height: 48px;
  flex: none;
  border-radius: 4px;
  object-fit: contain;
  background: var(--bg-raise-2);
}

.sprite-info {
  flex: 1;
  min-width: 0;
}

.sprite-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sprite-meta {
  font-size: 11.5px;
  color: var(--text-faint);
  margin-top: 2px;
}

/* ---------------- Preview stage ---------------- */

/* Stage xem thử động cử động: cho phép cao tự do để lưới 6 khung lộ ra */
.preview-stage {
  position: relative;
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--line-soft);
  border-radius: 8px;
  padding: 10px;
  overflow: visible;
}

.stage-wrap {
  display: flex;
  justify-content: center;
}

.rig-preview-card {
  position: relative;
  display: flex;
  justify-content: center;
  padding: 12px 8px;
}

.rig-preview-card canvas,
.rig-preview-card img {
  position: relative;
  width: 100%;
  max-width: 320px;
  max-height: 56vh;
  background: #141924;
  border: 1px solid var(--line-soft);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
}

@media (max-width: 760px) {
  .rig-controls { flex-direction: column; align-items: stretch; }
  .rig-status { margin-left: 0; margin-top: 8px; text-align: center; }
}
